# 复制为 .env 后按需修改；.env 已被 gitignore，不会提交。
# docker compose 会自动读取同目录下的 .env

# 本地 MySQL root 密码（仅开发环境，勿用于生产）
MYSQL_ROOT_PASSWORD=demo-root-only

# 后端连接串（与 docker-compose.yml 暴露的 3310 端口对应）
DB_URL=jdbc:mysql://127.0.0.1:3310/class_management_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=demo-root-only

# JWT 签名密钥，至少 32 字符。生产环境必须自行生成并保密。
# 生成示例：openssl rand -hex 32
JWT_SECRET=

# 首次初始化管理员（密码至少 12 位；留空则跳过初始化，不覆盖已有账号）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# DeepSeek；不填则 AI 助手不可用，其余功能正常
DEEPSEEK_API_KEY=
