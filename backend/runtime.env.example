# 配置模板，应用不会自动读取该文件。只在后端进程环境设置，不放入 frontend。
DB_URL=jdbc:mysql://127.0.0.1:3306/class_management_demo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=<专用库账号>
DB_PASSWORD=<本地设置的数据库密码>
JWT_SECRET=<至少32字节的随机密钥>
BOOTSTRAP_ADMIN_USERNAME=demo-admin
BOOTSTRAP_ADMIN_PASSWORD=<本地设置且至少12字符的演示专用密码>
SERVER_PORT=8091
DEEPSEEK_API_KEY=<仅在本地设置>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_ENGINE=dify
DIFY_API_URL=http://127.0.0.1:8088/v1
DIFY_API_KEY=<Dify应用密钥，仅在本地配置>
AI_OCR_SCRIPT=<scripts/Read-ImageText.ps1的本机绝对路径>
